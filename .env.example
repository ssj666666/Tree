# Tree — copy to .env and fill in. Never commit .env, and never paste a real key into chat.
# Step 1 needs ONLY: DEEPSEEK_API_KEY + DEV_LOGIN=1. Everything else is optional.

# Required: DeepSeek API key (model DeepSeek V4.1 Flash, API id deepseek-flash).
DEEPSEEK_API_KEY=       # from the DeepSeek open platform console (sk-...)
DEEPSEEK_MODEL=deepseek-flash

# Optional: Composio (app connections / sign-in). Leave empty to disable; text chat still works.
COMPOSIO_API_KEY=

# Optional: Orgo cloud computers. Leave empty to disable; text chat still works.
ORGO_API_KEY=
ORGO_WORKSPACE_ID=
ORGO_RAM_GB=8
ORGO_CPU=2
ORGO_RESOLUTION=1280x800x24

PORT=8787
APP_URL=http://localhost:5173     # where the web app is served
SERVER_URL=http://localhost:8787  # public URL of this server
SESSION_SECRET=         # optional in step 1 (dev default is used when empty)
DEV_LOGIN=1             # 1 enables POST /api/auth/dev — email sign-in for local/personal use only

# Admin login (Tree step 2): single admin, username + password hash.
# Generate the hash with: node bin/set-admin-password.mjs
# Then paste the printed hash below. Never put the plain password here.
TREE_ADMIN_USER=tree
TREE_ADMIN_PASSWORD_HASH=

# Optional: Bocha web-search API key (for the web_search tool / Scout bot).
# Leave empty to disable: the tool then tells the bot search is not configured.
BOCHA_API_KEY=

# Step 3.1 — "local hands": the workspace the bots may act on
# (run_shell / read_file / write_file). Defaults to /root/tree.
TREE_WORKSPACE=/root/tree

# Step 3.2 — headless browser (browse_page tool). Both optional.
# TREE_CHROMIUM_PATH: use a system Chromium instead of Playwright's bundled
# one, e.g. /usr/bin/chromium-browser. Leave empty for the bundled build.
# TREE_BROWSE_TIMEOUT_MS: overall budget for one browse_page call (ms).
# TREE_CHROMIUM_PATH=
# TREE_BROWSE_TIMEOUT_MS=60000

# Step 3.4 — one virtual screen per bot (Xvfb displays). Optional.
# Base display number: Quinn = base+0, Scout = base+1, Forge = base+2,
# Ledger = base+3, Brief = base+4. Default 11 (Quinn :11 … Brief :15).
# TREE_XVFB_BASE_DISPLAY=11

# Step 4 — voice (Alibaba Bailian / DashScope): ASR qwen3-asr-flash ->
# DeepSeek -> TTS cosyvoice-v3-flash. All optional: leave the key empty and
# voice endpoints answer "not configured" in Chinese; text chat still works.
# Key: Bailian console -> API Key (sk-...). Workspace ID: the first label of
# the {WorkspaceId}.cn-beijing.maas.aliyuncs.com domain (console -> 业务空间）.
# Leave DASHSCOPE_WORKSPACE_ID empty to fall back to dashscope.aliyuncs.com.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
TREE_TTS_MODEL=cosyvoice-v3-flash
TREE_TTS_VOICE=longyingtao_v3   # customer-service female voice （温柔淡定女）; alt: longyingmu_v3
TREE_ASR_MODEL=qwen3-asr-flash
